# Loadable modules.
#
# `# CONFIG_MODULES is not set` in arm64_defconfig, and the port's own notes
# rank this above the seccomp work: without modules no guest driver loads at all.
#
# The loader is already wired for this subarch -- arch/arm64/um/Makefile builds
# the parent architecture's module.c, module-plts.c and insn.c, and
# arch/arm64/um/asm/{module.h,module.lds.h} supply the struct mod_arch_specific
# and the .plt/.init.plt sections those two need under ARCH=um. But "wired" is
# not "works", and nothing has ever loaded a module in this port: this config is
# what the module gates build, so that the answer comes from a running guest
# rather than from the fact that the objects compile.
#
# The gates load a module at mem=64M, 512M and 3G, because the module region's
# placement decides which relocation paths are taken: 64M needs no PLT, 512M
# makes PLTs mandatory (the module is far enough from the kernel text that CALL26
# cannot reach), and 3G puts ADRP near its limit and exercises the veneer. Testing
# only the default would silently skip the entire PLT path.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
