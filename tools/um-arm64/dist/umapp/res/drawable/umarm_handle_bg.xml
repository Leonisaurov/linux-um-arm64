<?xml version="1.0" encoding="utf-8"?>
<!--
  The drawer handle: the one control that is always on screen, so it is a
  translucent circle rather than a button, so it should be findable rather than
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E6414141" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#B31A1A1A" />
            <stroke
                android:width="1dp"
                android:color="#3A3A3A" />
        </shape>
    </item>
</selector>
