<?xml version="1.0" encoding="utf-8"?>
<!--
  One key of the drawer's key grid. Selected is the latched state of CTRL, ALT,
  SHIFT and FN, which is what the view reads back through readControlKey() and
  friends; it has to be visible or a latched modifier is invisible until the next
  character comes out wrong.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1B5E20" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF66BB6A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF262626" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF3A3A3A" />
        </shape>
    </item>
</selector>
