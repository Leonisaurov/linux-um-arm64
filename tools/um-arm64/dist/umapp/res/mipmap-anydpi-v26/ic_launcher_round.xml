<?xml version="1.0" encoding="utf-8"?>
<!--
  android:roundIcon. A duplicate on purpose: the resource has to exist for a
  device that asks for the round variant, and pointing it at @mipmap/
  ic_launcher would work, but then a launcher that draws both would cache the
  same bitmap under two ids and the manifest would claim a round icon it does
  not have.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
