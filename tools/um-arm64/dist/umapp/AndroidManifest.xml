<?xml version="1.0" encoding="utf-8"?>
<!--
  umarm - a Linux kernel running inside an ordinary Android app.

  The point of packaging it as an app rather than an adb shell script is that
  the app sandbox is much narrower than the shell's: an app runs in the
  untrusted_app SELinux domain, under a W^X policy that forbids executing
  anything the app wrote itself. The only directory an app may execute from is
  the native library directory unpacked from its own APK, which is why the
  kernel, the stub, passt, umnet and umusb are all shipped as lib*.so.

  android:extractNativeLibs="true" matters for the same reason: the binaries
  have to exist as real files on disk to be exec'd, not mapped straight out of
  a compressed APK.

  The guest image is deliberately *not* in here. It is 144 MB gzipped, it is
  rebuilt whenever Alpine or the guest scripts change, and none of that has
  anything to do with this code, so it is a release asset the app downloads
  once and compares against on every start (RELEASES_API in MainActivity),
  instead of something whose version was the APK's.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.umarm.debian"
    android:versionCode="3"
    android:versionName="0.3">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!--
      Without this the guest has no network and the reason is well hidden.
      Android gates socket(2) on group membership rather than on a check at
      connect time: the INTERNET permission is what puts the app's uid in the
      "inet" group, and without it every socket() an app makes returns EPERM.
      passt, which is what gives the guest its network, then comes up, prints
      its DHCP and DNS configuration exactly as if it had worked, and only then
      fails with "Error refilling IPv4 host socket pool: Operation not
      permitted". The guest boots, gets a lease, and can reach nothing.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      To install the update it downloaded. Android has no implicit permission
      for this even when the APK is signed by the same key: without the
      declaration the package installer refuses the intent, and the user has to
      find and allow "install unknown apps" for umarm in Settings. The
      declaration asks for the capability; the user still grants it, and the app
      sends them there rather than failing silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      A Linux kernel the user started should not die because they looked at
      something else. Android only lets a process say that through a foreground
      service, which is what UmarmService is: the ongoing notification is the
      price, and the wakelock keeps the CPU running with the screen off.
      POST_NOTIFICATIONS is a runtime permission from API 33 and is asked for
      when the guest boots; the notification is still the service's, denied or
      not, and the guest keeps running either way.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      USB host mode, for handing a Realtek RTL8811AU through to the guest.

      required="false" on purpose: this is the app's optional trick, not its
      reason to exist. Declared required, the platform would refuse to install
      it on any device without USB host support, and most runs here have
      nothing plugged in at all.

      There is no permission to declare alongside it. Access to a USB device
      is granted per device, at runtime, by the user, and the descriptor comes
      back through UsbDeviceConnection; an app never opens /dev/bus/usb.
    -->
    <uses-feature android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:label="umarm"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:debuggable="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="umarm"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Plugging the adapter in offers to launch umarm, and the platform
              then grants permission to that device with no dialog. Worth
              having: the alternative is a dialog that has to be answered
              before the guest can start.

              singleTop above belongs to this. Without it, attaching the
              adapter while a guest is running would stack a second Activity
              on top of the boot in progress instead of delivering the intent
              to the one already there.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!--
          The identity of this build: a digest of everything that went into it,
          substituted by build-apk.sh. The update check compares it with the
          newest umarm-* release, which is why nothing has to remember to bump a
          version for an update to be noticed. See the RECIPE comment there.
        -->
        <meta-data
            android:name="org.umarm.recipe"
            android:value="__UMARM_RECIPE__" />

        <!--
          Serves the downloaded update to the package installer over
          content://. Not exported, and the URI permission is granted per
          intent, not held; see ApkProvider.
        -->
        <provider
            android:name=".ApkProvider"
            android:authorities="org.umarm.debian.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          The foreground service that keeps the guest alive off-screen. The
          type is specialUse because what it runs is a guest the user started,
          not a download or a sync, and API 34 requires a type. Not exported:
          nothing outside the app has any reason to start or stop it.
        -->
        <service
            android:name=".UmarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="runs a Linux guest the user started, stoppable from its notification" />
        </service>
    </application>
</manifest>
