#!/bin/sh
# Gate 10: a real module loads, relocates, and takes effect.
#
# The loader is the parent architecture's code (arch/arm64/kernel/module.c and
# module-plts.c, built into UML unchanged), so what is under test here is whether
# that code works when the host is a userspace process: the relocation arithmetic
# runs at EL0, the module's text is allocated through UML's own vmalloc, and
# nothing about it is arm64-hardware-specific until a PLT veneer has to be
# executed.
#
# The module is not built here. It comes through hostfs, from `make modules` on
# the same tree that produced the kernel, which is what makes it a test of the
# loader rather than of a hand-written fixture: it is a real .ko with real
# relocations against real kernel symbols.
#
# Two things about the check. First, `/proc/modules` is bookkeeping -- a module
# can appear there with its relocations applied to the wrong addresses, and the
# only way to find out is to make it do its job. binfmt_misc is chosen because
# its job is visible from userspace: it registers a filesystem, so it turns up in
# /proc/filesystems, and that only happens if its init function ran and its call
# into the kernel landed somewhere valid.
#
# Second, the memory size is a parameter of the test and not of the fixture. The
# module region's placement decides which relocation paths are taken: at 64M no
# PLT is needed, at 512M the module is far enough from the kernel text that a
# direct CALL26 cannot reach and PLTs are mandatory, and at 3G ADRP is near its
# limit and the ADRP veneer comes into play. A single run at the default skips
# the entire PLT path while looking green.
#
# Run as:  init=/module-init ubd0=alpine.ext4 root=/dev/ubda rw hostfs=<dir>

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

fail() {
	echo "GATEMODULE_FAIL: $*"
	exit 1
}

mkdir -p /proc /sys /dev /tmp /mnt/host 2>/dev/null
mount -t proc     proc     /proc 2>/dev/null
mount -t sysfs    sysfs    /sys  2>/dev/null
mount -t devtmpfs devtmpfs /dev  2>/dev/null
mount -t tmpfs    tmpfs    /tmp  2>/dev/null

[ -r /proc/self/stat ] || fail "procfs is not mounted"
[ -r /proc/modules ] || fail "no /proc/modules, so CONFIG_MODULES is not on"

command -v insmod >/dev/null 2>&1 || fail "no insmod in the image"

# The share arrives as hostfs= on the kernel command line, which also confines
# every hostfs mount to that tree.
mount -t hostfs hostfs /mnt/host || fail "mount -t hostfs"

set -- /mnt/host/*.ko
[ -f "$1" ] || fail "no .ko in the host share"

for ko in "$@"; do
	echo "GATEMODULE insmod $(basename "$ko")"
	insmod "$ko" || fail "insmod $(basename "$ko") failed"
done

grep -q '^binfmt_misc ' /proc/modules || fail "binfmt_misc is not in /proc/modules"

# The effect rather than the bookkeeping: registering the filesystem is what the
# module is for, and it is only visible here if its init ran and its calls into
# the kernel went to the right addresses.
grep -q 'binfmt_misc' /proc/filesystems || fail "binfmt_misc registered no filesystem"

# The module's own text and data have to be readable back, which is the one thing
# a relocation applied to the wrong address cannot survive: the module's name and
# size in /proc/modules come out of the module's own memory.
mod_size=$(awk '/^binfmt_misc / {print $2}' /proc/modules)
[ -n "$mod_size" ] || fail "no size for binfmt_misc in /proc/modules"

# rmmod as well, because MODULE_UNLOAD is on and the unload path frees the
# module's allocation through the same vmalloc UML gave it. Reverse order, and
# every module has to come out: a module that will not unload is as much a
# loader bug as one that will not load.
if command -v rmmod >/dev/null 2>&1; then
	set -- /mnt/host/*.ko
	for ko in "$@"; do
		mod=$(basename "$ko" .ko)
		rmmod "$mod" || fail "rmmod $mod failed"
		grep -q "^$mod " /proc/modules && fail "$mod still loaded after rmmod"
	done
	grep -q 'binfmt_misc' /proc/filesystems && fail "the filesystem outlived the module"
	echo "GATEMODULE rmmod ok"
fi

echo "GATEMODULE ok size=$mod_size"
echo "UMARM_BOOT_OK"

sync
exec /umarm-poweroff
