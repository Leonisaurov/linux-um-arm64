#!/bin/sh
# Gate 3: boot an Alpine root filesystem from a block device (ubd0 =
# /dev/ubda) and prove the guest is a working Linux, not just a kernel that can
# reach an initramfs.
#
# The marker is printed only after every check has passed. The verdict is the
# marker, so printing it first would make the gate meaningless: what this gate
# is for is the guest VFS, the block device, fork/exec and process teardown, and
# none of those are exercised by an initramfs whose /init is a single static
# binary.
#
# Run as:  init=/gate3-init ubd0=alpine.ext4 root=/dev/ubda rw

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

fail() {
	echo "GATE3_FAIL: $*"
	exit 1
}

# Mount only what is not already mounted: the kernel mounts devtmpfs itself
# (CONFIG_DEVTMPFS_MOUNT=y), and a second mount of the same type on the same
# point is EBUSY, which would fail the gate for a reason that is not a bug.
maybe_mount() {
	[ -r /proc/mounts ] || return 0
	grep -qs " $2 " /proc/mounts && return 0
	mount -t "$1" "$1" "$2" || fail "mount $2 ($1)"
}

maybe_mount proc /proc
maybe_mount sysfs /sys
maybe_mount devtmpfs /dev
maybe_mount tmpfs /tmp

[ -r /proc/mounts ] || fail "procfs is not mounted"
[ "$(uname -m)" = aarch64 ] || fail "uname -m=$(uname -m)"

# The root must be the block device, not an initramfs or a tmpfs: this is what
# separates gate 3 from gate 2.
rootdev=$(awk '$2 == "/" { print $1 }' /proc/mounts)
case "$rootdev" in
	/dev/ubda*|/dev/root) ;;
	*) fail "root device is '${rootdev:-none}', expected /dev/ubda" ;;
esac

# A real pipeline: several busybox processes forked and exec'd, with a result
# that is checkable rather than merely printed.
sum=$(seq 1 100 | awk '{ s += $1 } END { print s }')
[ "$sum" = 5050 ] || fail "pipeline sum=$sum, expected 5050"

# Read and write through the VFS, so a read-only or broken mount is caught.
echo gate3 > /tmp/gate3.txt || fail "write to /tmp"
[ "$(cat /tmp/gate3.txt)" = gate3 ] || fail "read back from /tmp"
echo gate3-block > /gate3.txt || fail "write to the root filesystem"
[ "$(cat /gate3.txt)" = gate3-block ] || fail "read back from the root filesystem"
rm -f /gate3.txt

# Sequential fork/exec. 200 is enough to catch the fork and teardown bugs the
# port fixed, and cheap enough for a gate that runs on every push.
i=0
while [ "$i" -lt 200 ]; do
	/bin/true || fail "exec /bin/true, iteration $i"
	i=$((i + 1))
done

# Concurrency, which the sequential loop above cannot catch.
c=0
while [ "$c" -lt 16 ]; do
	sleep 0 &
	c=$((c + 1))
done
wait

echo "GATE3 ok root=$rootdev arch=$(uname -m) sum=$sum procs=$i+$c"
echo "UMARM_BOOT_OK"

# Power the machine off rather than exiting: init exiting without reboot is a
# panic under panic=-1, which blunts the failure signal.
poweroff -f

# If poweroff did not take, do not leave the harness waiting.
sleep 5
exit 0
