#!/bin/sh
# Gate 7 (CI form): a Debian userland with build-essential, where the guest's
# own compiler builds a program that runs and computes the right answer.
#
# The port's original gate 7 was `apt install build-essential` *inside* the
# guest, and then a 60 MB decompression compared byte-for-byte against a host
# reference. The apt half needs guest networking, which CI cannot provide, so the
# Debian image is built with build-essential already in it and this gate keeps
# the part that carries the risk: a real gcc, a real glibc, a real dynamic
# loader, and a program whose output is checked rather than merely printed.
#
# The program deliberately uses libm and pthreads. Those are the two things the
# original gate 7 found broken -- the FP save/restore bug showed up under dpkg
# and a compiler, not under busybox -- and a compiler that produces a binary is
# no evidence that the binary computes correctly.
#
# Run as:  init=/gate7-init ubd0=debian.ext4 root=/dev/ubda rw

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

fail() {
	echo "GATEG7_FAIL: $*"
	exit 1
}

mkdir -p /proc /sys /dev /tmp 2>/dev/null
mount -t proc     proc     /proc 2>/dev/null
mount -t sysfs    sysfs    /sys  2>/dev/null
mount -t devtmpfs devtmpfs /dev  2>/dev/null
mount -t tmpfs    tmpfs    /tmp  2>/dev/null

[ -r /proc/self/stat ] || fail "procfs is not mounted"

# The point of a Debian image here is its own toolchain.
command -v gcc >/dev/null 2>&1 || fail "no gcc in the image"
command -v make >/dev/null 2>&1 || fail "no make in the image"
dpkg -s build-essential >/dev/null 2>&1 || fail "build-essential is not installed"

# glibc, not a static musl binary: the dynamic loader is part of what is under
# test.
ldd /bin/sh >/dev/null 2>&1 || fail "the dynamic loader is not working"

cat > /tmp/gate7.c <<'EOF'
#include <math.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>

#define NTHREADS 4
#define PER_THREAD 10000

static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
static long counter;

static void *worker(void *arg)
{
	long i;

	for (i = 0; i < PER_THREAD; i++) {
		pthread_mutex_lock(&lock);
		counter++;
		pthread_mutex_unlock(&lock);
	}
	return arg;
}

int main(void)
{
	pthread_t t[NTHREADS];
	double s = 0.0;
	long i;
	int rc;

	/* libm: an identity that is exact only if FP is not corrupted. */
	if (fabs(sqrt(2.0) * sqrt(2.0) - 2.0) > 1e-12) {
		printf("GATE7_C_BAD sqrt identity\n");
		return 1;
	}
	for (i = 1; i <= 100000; i++)
		s += sqrt((double)i);
	if (!(s > 0.0) || !isfinite(s)) {
		printf("GATE7_C_BAD sqrt sum\n");
		return 1;
	}
	/* The same sum a second way: a truncated or swapped register pair shows up
	 * as a disagreement between the two. */
	{
		double s2 = 0.0;

		for (i = 1; i <= 100000; i++)
			s2 += pow((double)i, 0.5);
		if (fabs(s - s2) > 1e-6) {
			printf("GATE7_C_BAD sqrt/pow disagree %.9f %.9f\n", s, s2);
			return 1;
		}
	}

	/* pthreads: 4 threads over a shared counter, which is where the guest's
	 * TLS handling and clone flags are exercised. */
	for (i = 0; i < NTHREADS; i++) {
		rc = pthread_create(&t[i], NULL, worker, NULL);
		if (rc != 0) {
			printf("GATE7_C_BAD pthread_create %d\n", rc);
			return 1;
		}
	}
	for (i = 0; i < NTHREADS; i++)
		pthread_join(t[i], NULL);

	if (counter != (long)NTHREADS * PER_THREAD) {
		printf("GATE7_C_BAD counter %ld\n", counter);
		return 1;
	}

	printf("GATE7_C_OK threads=%d counter=%ld sum=%.3f\n",
	       NTHREADS, counter, s);
	return 0;
}
EOF

gcc -O2 -Wall -o /tmp/gate7 /tmp/gate7.c -lm -lpthread || fail "gcc failed"
out=$(/tmp/gate7) || fail "the guest's own program failed: $out"
case "$out" in
GATE7_C_OK*) ;;
*) fail "wrong output: $out" ;;
esac

echo "GATE7 ok gcc=$(gcc -dumpversion) $out"
echo "UMARM_BOOT_OK"

sync
exec /umarm-poweroff
